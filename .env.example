# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL="https://votre-projet.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="votre_anon_key_publique"
SUPABASE_SERVICE_ROLE_KEY="votre_service_role_key_secrete"

# --- E-mails (Resend) ---
# L'adresse d'expédition DOIT appartenir à un domaine vérifié dans Resend.
# Avec onboarding@resend.dev, Resend n'envoie qu'à l'adresse du propriétaire du compte.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="UJLOG Étudiant <noreply@ujlog-etudiant.site>"

# Secret partagé de /api/cron/dispatch-emails (file d'attente des e-mails)
CRON_SECRET="générez_une_valeur_aléatoire_longue"

# --- Stockage des documents (Cloudinary) ---
CLOUDINARY_CLOUD_NAME="votre_cloud_name"
CLOUDINARY_API_KEY="votre_api_key"
CLOUDINARY_API_SECRET="votre_api_secret"

# --- Application ---
# URL publique utilisée dans les liens envoyés par e-mail (confirmation, réinitialisation, invitations).
NEXT_PUBLIC_APP_URL="https://ujlog-etudiant.site"
# Année universitaire courante (à changer à chaque rentrée).
NEXT_PUBLIC_CURRENT_ACADEMIC_YEAR="2026-2027"
# Durée de validité des invitations admin/délégué (heures).
ROLE_INVITATION_EXPIRY_HOURS="24"
LOG_LEVEL="INFO"
